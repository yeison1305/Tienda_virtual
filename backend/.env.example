# Supabase
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_KEY=

# Wompi
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# Email (Brevo REST API - libre de bloqueos de puertos SMTP en hostings)
# Crear en Brevo: Settings -> SMTP & API -> API Keys (empieza con xkeysib-)
BREVO_API_KEY=
EMAIL_FROM="VOID Culture" <noreply@void.co>

# App
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# JWT - obligatoria (genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
